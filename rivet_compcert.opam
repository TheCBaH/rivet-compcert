build: [
  ["make" "opam-build"]
]
install: [
  ["make" "opam-install" "PREFIX=%{prefix}%"]
]
# None of these are in opam-repository yet, and pin-depends is not transitive: Rivet is the
# commit vendor/rivet pins, err_trace the one that Rivet pins.
pin-depends: [
  ["err_trace.0.3.0" "git+https://github.com/TheCBaH/err_trace.git#8138a417b452e55483028df851cb562fbf175eed"]
  ["rivet.dev" "git+https://github.com/TheCBaH/rivet.git#d7ee073ff46e0b5c430f769bd1ff67a914a2e246"]
  ["rivet-native-exec.dev" "git+https://github.com/TheCBaH/rivet.git#d7ee073ff46e0b5c430f769bd1ff67a914a2e246"]
]
