opam-version: "2.0"
synopsis: "CompCert embedded in-process behind rivet's driver"
description: """
C source in, a laid-out rivet image out, with nothing written to disk: the
host ISA's CompCert, extracted to OCaml and patched to read and print through
memory, drives rivet's assembler. The CompCert artifacts are the release
pinned in compcert.lock, fetched by opam as extra sources (no Rocq needed), and
the variant is installed as compcert_<isa>_embed.

Content derived from CompCert is covered by CompCert's own non-commercial
license, reproduced in LICENSE.CompCert.
"""
maintainer: "Vladimir N. Silyaev"
authors: ["Vladimir N. Silyaev"]
license: ["MIT" "LicenseRef-CompCert"]
homepage: "https://github.com/TheCBaH/rivet-compcert"
bug-reports: "https://github.com/TheCBaH/rivet-compcert/issues"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.15"}
  "menhir"
  "err_trace" {>= "0.3.0"}
  "rivet"
  "rivet-native-exec"
]
# The CompCert artifacts pinned in compcert.lock, one entry per line of it. opam
# stages them in the build directory, so the build needs no network.
extra-source "compcert-export-x86_32.tar.gz" {
  src: "https://github.com/TheCBaH/devcontainer.CompCert/releases/download/v3.17-4/compcert-export-x86_32.tar.gz"
  checksum: "sha256=0cd61a8ed7abf419ace2e33b64d9c94edab0475cbffbed8c1364314846c23357"
}
