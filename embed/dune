; In-process CompCert: C source string -> assembly text -> laid-out image,
; with nothing written to disk.
;
; Gated like compcert_adapter/: it links the embed variant of CompCert
; (compcert_aarch64_embed, from ../../compcert-lib-aarch64-embed, resolved via
; OCAMLPATH), which needs a Rocq extraction, so it must stay out of every
; default build. ASM_COMPCERT_EMBED is set only by the asm-compcert-embed-test
; Makefile target.

(library
 (name compcert_embed)
 (modes byte native)
 (libraries compcert_aarch64_embed foundation asm_core image driver fmt)
 (enabled_if
  (= %{env:ASM_COMPCERT_EMBED=false} true)))
