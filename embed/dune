; In-process CompCert: C source string -> assembly text -> laid-out image,
; with nothing written to disk. This is the target-agnostic core;
; targets/<target>/ instantiates it for each target's CompCert embed variant.
;
; Gated like compcert_adapter/: the per-target libraries link a CompCert
; build, which needs a Rocq extraction, so all of this must stay out of every
; default build. RIVET_COMPCERT_EMBED is set only by the asm-compcert-embed-*
; Makefile targets.

(library
 (name compcert_embed)
 (public_name rivet_compcert.compcert_embed)
 (modes byte native)
 (libraries
  rivet.foundation
  rivet.asm_core
  rivet.image
  rivet.driver
  rivet.target_intf
  rivet.native_exec
  rivet.fmt)
 (enabled_if
  (= %{env:RIVET_COMPCERT_EMBED=false} true)))
