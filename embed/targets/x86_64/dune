; Compcert_embed for x86_64: the shared shim (../../shim) over this target's
; CompCert embed variant (compcert_x86_64_embed, from
; ../../../../compcert-lib-x86_64-embed, resolved via OCAMLPATH). Enabled only
; when that variant has been built, which RIVET_COMPCERT_EMBED_X86_64 says.

(copy_files# ../../shim/cc_compile.ml)

(library
 (name compcert_embed_x86_64)
 (modes byte native)
 (libraries
  compcert_embed
  compcert_x86_64_embed
  rivet.x86_64
  rivet.native_exec)
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_X86_64=false} true))))
