; Compcert_embed for riscv64: the shared shim (../../shim) over this target's
; CompCert embed variant (compcert_riscv64_embed, from
; ../../../../compcert-lib-riscv64-embed, resolved via OCAMLPATH). Enabled only
; when that variant has been built, which RIVET_COMPCERT_EMBED_RISCV64 says.

(copy_files# ../../shim/cc_compile.ml)

(library
 (name compcert_embed_riscv64)
 (modes byte native)
 (libraries compcert_embed compcert_riscv64_embed rivet.riscv64 rivet.native_exec)
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_RISCV64=false} true))))
