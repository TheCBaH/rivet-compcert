; Tier A for x86_32 (../../../tier_a/tier_a_test.ml): C -> assembly -> image
; against the committed fixtures. The report must equal tier_a.expected.

(copy_files# ../../../tier_a/tier_a_test.ml)

(copy_files# ../../../qemu/qemu_diff.ml)

; tier_a_test is the report below. qemu_diff runs the corpus under QEMU (make
; asm-compcert-embed-qemu-x86_32), and natively too on a host of this ISA; it is
; not a test rule, since it needs the target's QEMU and the exec-ABI
; helpers, like the other oracle legs.

(executables
 (names tier_a_test qemu_diff)
 (libraries
  compcert_embed
  compcert_embed_x86_32
  rivet.native_exec
  rivet.image
  rivet.foundation
  rivet.oracle
  rivet.oracle_run
  rivet.fmt)
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_X86_32=false} true))))

(rule
 (deps
  (source_tree ../../../../fixtures/compcert-3.17))
 (action
  (with-stdout-to
   tier_a.output
   (run %{exe:tier_a_test.exe} ../../../../fixtures/compcert-3.17)))
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_X86_32=false} true))))

(rule
 (alias runtest)
 (action
  (diff tier_a.expected tier_a.output))
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_X86_32=false} true))))
