; Compcert_embed for x86_32: the shared shim (../../shim) over this target's
; CompCert embed variant (compcert_x86_32_embed, from
; ../../../../compcert-lib-x86_32-embed, resolved via OCAMLPATH). Enabled only
; when that variant has been built, which RIVET_COMPCERT_EMBED_X86_32 says.

(copy_files# ../../shim/cc_compile.ml)

(library
 (name compcert_embed_x86_32)
 (public_name rivet_compcert.compcert_embed_x86_32)
 (modes byte native)
 (libraries
  compcert_embed
  compcert_x86_32_embed
  rivet.x86_32
  rivet.native_exec)
 (enabled_if
  (and
   (= %{env:RIVET_COMPCERT_EMBED=false} true)
   (= %{env:RIVET_COMPCERT_EMBED_X86_32=false} true))))
