; The M1.5 differential gate. Reads the committed fixtures and their GNU oracle
; artifacts as ordinary files, so this needs no cross toolchain and no emulator
; and runs in every leg of the portable matrix.

(library
 (name test_differential)
 (modules test_differential)
 (modes byte native)
 (libraries
  rivet.driver
  rivet.image
  rivet.target_intf
  rivet.foundation
  rivet.test_dump_inputs
  rivet.fmt)
 (inline_tests
  (deps
   (glob_files_rec %{workspace_root}/fixtures/compcert-3.17/**)))
 (preprocess
  (pps ppx_expect))
 (enabled_if
  (<> %{env:RIVET_MELANGE=false} true)))
